# ---------------------------------------------------------------------------
# Edge Functions（api / worker）用の環境変数
#   cp .env.example .env
#   supabase functions serve --env-file .env
# dev 環境では同じ名前で `supabase secrets set --env-file ...` により登録する。
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_DB_URL は
# Edge Runtime が自動で設定するため、ここには書かない（SUPABASE_ で始まる名前は予約）。
# ---------------------------------------------------------------------------

# モック（dev のみ true）。true のとき X-Mock-Scenario を受け付け、第2段階 API はモック応答を返す
MOCK_MODE=true

# 生成モックが completed になるまでの秒数（設計書 API09：約5秒）
MOCK_GENERATION_DELAY_SECONDS=5

# 署名付き URL をアプリへ返すときの公開 URL。local は http://127.0.0.1:54321
# （Edge Runtime 内の SUPABASE_URL はコンテナ名になるため）。dev は空でよい（SUPABASE_URL を使う）
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# アクセストークンの検証。ES256 等の非対称鍵（JWT Signing Keys。Supabase CLI 2.x の local 既定）は
# JWKS（/auth/v1/.well-known/jwks.json）で自動的に検証するため設定不要。
# HS256（従来の JWT Secret）で署名するプロジェクトだけ、その値を設定する（local の値は CLI の既定値）
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# api → worker の起動と pg_cron → worker の呼び出しに使う共有シークレット（任意の長い文字列）
WORKER_SECRET=change-me-local-worker-secret

# 1ユーザーあたりの利用制限（回/分）。設計書 API01：60回/分（提案）
RATE_LIMIT_PER_MINUTE=60
