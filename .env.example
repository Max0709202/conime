# Copy to .env.local (local) — never commit real values. Staging/production values are
# set as Supabase Edge Function secrets (see docs/DEPLOYMENT.md), not in files.

# --- environment
CONIME_ENV=local                      # local | test | staging | production

# --- database (Edge Functions receive SUPABASE_DB_URL automatically when deployed)
CONIME_DB_URL=postgresql://postgres@127.0.0.1:54329/conime
CONIME_DB_POOL_MAX=5

# --- auth: either a JWKS (asymmetric Supabase signing keys) or the legacy HS256 secret
SUPABASE_URL=                         # e.g. http://127.0.0.1:54321 or https://<ref>.supabase.co
CONIME_JWT_SECRET=local-only-jwt-secret-change-me-at-least-32-characters
# CONIME_JWKS_URL=                    # default: $SUPABASE_URL/auth/v1/.well-known/jwks.json
# CONIME_JWT_ISSUER=                  # default: $SUPABASE_URL/auth/v1

# --- server-only secrets (NEVER shipped to the client)
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
WORKER_SECRET=local-only-worker-secret

# --- AI
AI_PROVIDER=mock                      # mock | openai
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- storage
STORAGE_DRIVER=local                  # local (filesystem emulator) | supabase
LOCAL_STORAGE_DIR=.dev-storage
LOCAL_STORAGE_SIGNING_KEY=local-only-storage-signing-key
PUBLIC_BASE_URL=http://127.0.0.1:8787
PORT=8787
