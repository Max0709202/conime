{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anime-recs-output-v1",
  "title": "Anime recommendation selection",
  "description": "work_id must be one of the supplied candidate IDs; at most result_limit items.",
  "type": "object",
  "additionalProperties": false,
  "required": ["recommendations"],
  "properties": {
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work_id", "reason"],
        "properties": { "work_id": { "type": "string" }, "reason": { "type": "string" } }
      }
    }
  }
}
