{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "normalization-output-v1",
  "title": "Free-text normalization result",
  "description": "matched_id must be one of the candidate IDs supplied for that item, or null.",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "matched_id", "confidence"],
        "properties": {
          "item_id": { "type": "string" },
          "matched_id": { "type": ["string", "null"] },
          "confidence": { "type": "number" }
        }
      }
    }
  }
}
