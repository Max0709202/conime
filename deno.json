{
  "nodeModulesDir": "none",
  "importMap": "./supabase/functions/import_map.json",
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 120,
    "indentWidth": 2,
    "singleQuote": false,
    "exclude": [
      "node_modules",
      "supabase/functions/_shared/generated",
      "postman"
    ]
  },
  "lint": {
    "exclude": [
      "node_modules",
      "supabase/functions/_shared/generated"
    ]
  },
  "tasks": {
    "schemas": "deno run -A scripts/export-schemas.ts",
    "seed": "deno run -A scripts/generate-seed.ts",
    "test:unit": "deno test -A tests/unit",
    "test:db": "bash scripts/test-db.sh",
    "test:integration": "bash scripts/test-integration.sh",
    "test:realtime": "deno run -A tests/realtime/realtime-client.ts",
    "test:ai-eval": "deno run -A tests/ai-evaluation/run-eval.ts",
    "dev": "bash scripts/dev-api.sh",
    "check": "deno check supabase/functions/api/index.ts supabase/functions/worker/index.ts scripts/*.ts tests/**/*.ts"
  },
  "exclude": [
    "node_modules"
  ]
}